---
import { Image } from "astro:assets";
import { APP_STORE_URL, PLAY_STORE_URL } from "@scripts/store-links";
import brandIcon from "@assets/images/PrimaryRounded_Web.png";
import appStoreBadge from "@assets/svg/app-store-badge.svg?url";
import macAppStoreBadge from "@assets/svg/mac-app-store-badge.svg?url";
import googlePlayBadge from "@assets/svg/google-play-badge.svg?url";

const badges = [
  {
    modifier: "ios",
    src: appStoreBadge,
    width: 215,
    alt: "Download WrestleVerse on the App Store",
    href: APP_STORE_URL,
  },
  {
    modifier: "mac",
    src: macAppStoreBadge,
    width: 281,
    alt: "Download WrestleVerse on the Mac App Store",
    href: APP_STORE_URL,
  },
  {
    modifier: "android",
    src: googlePlayBadge,
    width: 243,
    alt: "Get WrestleVerse on Google Play",
    href: PLAY_STORE_URL,
  },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <Image
      src={brandIcon}
      alt=""
      class="site-footer__icon"
      width={72}
      height={72}
      densities={[1, 2]}
      loading="lazy"
    />

    <span class="site-footer__brand-name">WrestleVerse</span>

    <p class="site-footer__copyright">
      &copy; {new Date().getFullYear()} Pixel Playworks
    </p>

    <div class="site-footer__badges" data-store-badges>
      {
        badges.map((badge) => (
          <a
            href={badge.href}
            class={`site-footer__badge site-footer__badge--${badge.modifier}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <img
              src={badge.src}
              alt={badge.alt}
              width={badge.width}
              height={72}
              loading="lazy"
            />
          </a>
        ))
      }
    </div>
  </div>
</footer>

<script>
  // Mobile shows a single badge. The markup defaults to the App Store one, so
  // only Android needs correcting.
  if (/Android/i.test(navigator.userAgent)) {
    document
      .querySelector("[data-store-badges]")
      ?.setAttribute("data-platform", "android");
  }
</script>

<style>
  .site-footer {
    margin-top: 96px;
    height: 160px;
    background: var(--color-surface-footer);
  }

  .site-footer__inner {
    height: 100%;
    padding-inline: 44px;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "icon name badges"
      "icon copy badges";
    align-content: center;
    align-items: center;
    column-gap: 16px;
  }

  .site-footer__icon {
    grid-area: icon;
  }

  .site-footer__brand-name {
    grid-area: name;
    font-family: var(--font-rounded);
    font-size: 2.25rem;
    line-height: 1.2;
  }

  .site-footer__copyright {
    grid-area: copy;
    font-size: 1.25rem;
    line-height: 1.4;
    opacity: 0.32;
  }

  .site-footer__badges {
    grid-area: badges;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .site-footer__badge {
    display: flex;
    border-radius: var(--radius-sm);
  }

  .site-footer__badge:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  @media (max-width: 1240px) {
    .site-footer {
      margin-top: 64px;
      height: 180px;
    }

    .site-footer__inner {
      padding-inline: 16px;
      grid-template-columns: auto auto;
      grid-template-areas:
        "icon badges"
        "copy copy";
      justify-content: center;
      row-gap: 24px;
    }

    .site-footer__brand-name {
      display: none;
    }

    .site-footer__copyright {
      justify-self: center;
    }

    .site-footer__badge--mac,
    .site-footer__badge--android {
      display: none;
    }

    .site-footer__badges[data-platform="android"] .site-footer__badge--ios {
      display: none;
    }

    .site-footer__badges[data-platform="android"] .site-footer__badge--android {
      display: flex;
    }
  }
</style>
