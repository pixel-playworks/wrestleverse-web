---
import { videoObject } from "@schema/video-object";
import type { YouTubeVideo } from "../data/videos";

interface Props {
  video: YouTubeVideo;
  // Inside an article: drops the page-section padding and matches the
  // article's text width.
  inline?: boolean;
}

const { video, inline = false } = Astro.props;

const videoSchema = videoObject(Astro.site, video);
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(videoSchema)}
/>

<section
  class:list={["video", { "video--inline": inline }]}
  aria-label={video.label}
>
  <!-- The embed pulls ~1 MB of third-party JS, so it is mounted once the
       section comes into view rather than on initial page load. -->
  <div
    class="video__frame"
    data-video={video.id}
    data-title={video.label}
  >
  </div>
</section>

<script>
  const mount = (slot: HTMLElement) => {
    const iframe = document.createElement("iframe");
    iframe.className = slot.className;
    iframe.src = `https://www.youtube-nocookie.com/embed/${slot.dataset.video}`;
    iframe.title = slot.dataset.title ?? "";
    iframe.allow = "encrypted-media; picture-in-picture; fullscreen";
    iframe.referrerPolicy = "strict-origin-when-cross-origin";
    iframe.allowFullscreen = true;
    slot.replaceWith(iframe);
  };

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        mount(entry.target as HTMLElement);
      }
    },
    { rootMargin: "200px" },
  );

  document
    .querySelectorAll<HTMLElement>("[data-video]")
    .forEach((slot) => observer.observe(slot));
</script>

<style>
  .video {
    padding: 96px var(--page-gutter);
  }

  /* Shared by the placeholder and the iframe that replaces it, so the swap
     cannot shift the page. Global because the injected iframe has no scope
     hash. 
     need for the iframe CSS selector at runtime
     before: .video__frame[data-astro-cid-mrk3q7f7] { ... }
     after: .video[data-astro-cid-mrk3q7f7] .video__frame { ... }
     */
  .video :global(.video__frame) {
    display: block;
    width: min(100%, var(--content-width));
    height: auto;
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: var(--radius-panel);
    background: var(--color-surface);
  }

  .video--inline {
    max-width: 820px;
    margin: 32px 0;
  }

  @media (max-width: 768px) {
    .video {
      padding: 36px var(--page-gutter) 64px;
    }
  }

  /* After the media query so it also wins on small screens. */
  .video.video--inline {
    padding: 0;
  }
</style>
