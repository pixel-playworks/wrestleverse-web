---
import "../styles/global.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Layout from "@layouts/Layout.astro";
import NewsCard from "@components/NewsCard.astro";
import { getCollection } from "astro:content";

// `getCollection` returns all entries in the `news` content collection.
// We sort by `date` descending so the newest article appears first.
const posts = await getCollection("news");
const sortedPosts = posts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout
  title="News | WrestleVerse"
  description="Stay up to date with the latest WrestleVerse news and updates."
>
  <Header />

  <main class="news-page">
    <div class="news-shell">
      <section class="news-intro" aria-labelledby="news-heading">
        <p class="news-kicker">News</p>
        <h1 id="news-heading">WrestleVerse Updates</h1>
        <p class="news-lede">
          Monthly update notes for <em>WrestleVerse</em> on iOS, iPadOS, macOS,
          and Android — new features, balance changes, and fixes, straight from
          the developers.
        </p>
      </section>

      <section class="news-grid" aria-label="Latest news">
        {sortedPosts.map((post) => <NewsCard post={post} />)}
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .news-page {
    min-height: calc(100svh - 96px);
    padding: 96px var(--page-gutter) 120px;
    background: var(--color-bg);
  }

  .news-shell {
    width: min(100%, 1200px);
    margin-inline: auto;
  }

  .news-intro {
    margin-bottom: 64px;
  }

  /* Matches the About page's h1 styling. */
  .news-intro h1 {
    max-width: 820px;
    margin-bottom: 24px;
    font-family: var(--font-display);
    font-size: clamp(3rem, 11vw, 8rem);
    font-weight: 500;
    line-height: 1;
    color: rgb(255 255 255 / 92%);
    text-shadow: 0 4px 18px rgb(184 200 255 / 18%);
  }

  .news-lede {
    max-width: 720px;
    font-family: var(--font-body);
    font-size: 1.25rem;
    line-height: 1.7;
    color: rgb(255 255 255 / 68%);
  }

  .news-lede em {
    font-style: italic;
    color: rgb(255 255 255 / 88%);
  }

  .news-kicker {
    margin-bottom: 16px;
    font-family: var(--font-rounded);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--btn-bg);
  }

  /* Responsive grid matching the design spec:
     3 columns by default, 2 below 1400px, 1 below 960px. */
  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 64px;
    justify-items: center;
  }

  @media (max-width: 1400px) {
    .news-grid {
      grid-template-columns: repeat(2, 348px);
      justify-content: center;
    }
  }

  @media (max-width: 960px) {
    .news-page {
      padding: 64px var(--page-gutter) 96px;
    }

    .news-intro {
      margin-bottom: 40px;
    }

    .news-lede {
      font-size: 1.125rem;
    }

    .news-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
