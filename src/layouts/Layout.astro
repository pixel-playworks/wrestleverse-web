---
import "../styles/global.css";
import { getImage } from "astro:assets";
import { APP_STORE_URL, PLAY_STORE_URL } from "@scripts/store-links";
import heroBg from "@assets/images/Hero_Desktop.jpeg";
import brandLogo from "@assets/images/PrimaryRounded_Web.png";

interface Props {
  title?: string;
  description?: string;
  /** og:type — pages default to "website", news posts pass "article". */
  type?: "website" | "article";
  /** Extra JSON-LD objects for the page (e.g. FAQPage, Article, VideoGame). */
  structuredData?: Record<string, unknown>[];
}
const {
  title = "WrestleVerse | The Top Mobile Wrestling GM Game",
  description = "Discover WrestleVerse, the premium mobile pro wrestling booking & management simulator. Book matches, run your promotion, and experience live-called commentary.",
  type = "website",
  structuredData = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const ogImage = await getImage({ src: heroBg, format: "jpeg", width: 1200 });
const ogImageURL = new URL(ogImage.src, Astro.site);
const logoImage = await getImage({ src: brandLogo, format: "png", width: 512 });

// Declares the WrestleVerse brand entity to search and AI engines.
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": new URL("/#organization", Astro.site).href,
  name: "WrestleVerse",
  url: Astro.site?.href,
  logo: new URL(logoImage.src, Astro.site).href,
  email: "james@wrestle.works",
  sameAs: [
    "https://www.instagram.com/wrestleverse.app",
    "https://www.facebook.com/wrestleverseapp",
    "https://www.youtube.com/@jtsaeed",
    "https://discord.com/invite/GKbXVpS3jD",
    APP_STORE_URL,
    PLAY_STORE_URL,
  ],
};

const jsonLd = [organizationSchema, ...structuredData];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="WrestleVerse" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta
      property="og:image:height"
      content={String(ogImage.attributes.height)}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {
      jsonLd.map((schema) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      ))
    }
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="fe8cb804-897e-4b8e-8d0a-c08c34d0a655"></script>
  </head>
  <body>
    <slot />

    <script>
      import { configureCtaLinks } from "@scripts/cta-links";

      configureCtaLinks();
    </script>
  </body>
</html>
