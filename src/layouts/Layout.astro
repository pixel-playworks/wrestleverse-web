---
import "../styles/global.css";
import { getImage } from "astro:assets";
import { organization } from "@schema/organization";
import heroBg from "@assets/images/Hero_Desktop.jpeg";
import brandLogo from "@assets/images/PrimaryRounded_Web.png";
// Same hashed files `global.css` points at, so the preload is reused.
import displayFont from "@assets/fonts/SFPro-Display-Medium.woff2?url";
import roundedFont from "@assets/fonts/SFPro-Rounded-Medium.woff2?url";

interface Props {
  title?: string;
  description?: string;
  /** og:type — pages default to "website", news posts pass "article". */
  type?: "website" | "article";
  /** Extra JSON-LD objects for the page (e.g. FAQPage, Article, VideoGame). */
  structuredData?: Record<string, unknown>[];
}
const {
  title = "WrestleVerse | The Top Mobile Wrestling GM Game",
  description = "Discover WrestleVerse, the premium mobile pro wrestling booking & management simulator. Book matches, run your promotion, and experience live-called commentary.",
  type = "website",
  structuredData = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const ogImage = await getImage({ src: heroBg, format: "jpeg", width: 1200 });
const ogImageURL = new URL(ogImage.src, Astro.site);
const logoImage = await getImage({ src: brandLogo, format: "png", width: 512 });

const organizationSchema = organization(Astro.site, logoImage.src);

const jsonLd = [organizationSchema, ...structuredData];

// Chromium browsers download the HTML of linked internal pages (~7 KB each)
// in the background, so a click renders without waiting on the network.
// Prefetch never runs the page, so analytics don't count unvisited pages.
// Unlike `<link rel="prefetch">`, this is reused even when the host sends
// `must-revalidate` on HTML (Netlify's default).
const speculationRules = {
  prefetch: [{ where: { href_matches: "/*" }, eagerness: "eager" }],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Body text and the header use these on every page. Fetching them before
         CSS asks for them stops text reflowing when they swap in. -->
    <link
      rel="preload"
      href={displayFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={roundedFont}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="WrestleVerse" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta
      property="og:image:height"
      content={String(ogImage.attributes.height)}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {
      jsonLd.map((schema) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      ))
    }
    <script
      is:inline
      type="speculationrules"
      set:html={JSON.stringify(speculationRules)}
    />
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="fe8cb804-897e-4b8e-8d0a-c08c34d0a655"></script>
  </head>
  <body>
    <slot />

    <script>
      import { configureCtaLinks } from "@scripts/cta-links";

      configureCtaLinks();
    </script>
  </body>
</html>
